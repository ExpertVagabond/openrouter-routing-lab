    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "coldstar-agent-signer": "^0.5.0"
  }
}
